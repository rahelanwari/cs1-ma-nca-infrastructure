# Local .terraform directories
**/.terraform/*

# .tfstate files - contain sensitive values (e.g. the generated DB password)
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files, likely to contain sensitive data
*.tfvars
*.tfvars.json

# Ignore override files (used to override resources locally)
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore CLI configuration files
.terraformrc
terraform.rc

# OS/editor noise
.DS_Store
.vscode/
