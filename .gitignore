# Local .terraform directories
**/.terraform/*

# .tfstate files - contain sensitive values (e.g. the generated DB password)
*.tfstate
*.tfstate.*

# Terraform plan files - can also contain sensitive values
tfplan
*.tfplan

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files, likely to contain sensitive data
*.tfvars
*.tfvars.json

# Ignore override files (used to override resources locally)
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore CLI configuration files
.terraformrc
terraform.rc

# Local tools (load test tools like hey.exe and bombardier.exe)
*.exe

# Private keys - never in Git
*.pem
*.key
id_rsa*
id_ed25519*

# Ansible
*.retry

# Python (SOAR option A)
__pycache__/
*.pyc
.venv/
.pytest_cache/
.env

# OS/editor noise
.DS_Store
.vscode/