{
  "title": "Dashboard RAHEL ANWARI CASE STUDY 1",
  "uid": "innovatech-cs1",
  "editable": true,
  "schemaVersion": 39,
  "version": 1,
  "time": {"from": "now-6h", "to": "now"},
  "refresh": "30s",
  "timezone": "browser",
  "tags": ["innovatech", "cs1"],
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Web Tier CPU Usage (%)",
      "description": "Average CPU usage of the Nginx tasks. Orange line = Auto Scaling target (60%), red line = high-CPU alarm (80%).",
      "datasource": {"type": "cloudwatch", "uid": "cloudwatch"},
      "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8},
      "fieldConfig": {"defaults": {"color": {"mode": "palette-classic"}, "custom": {"drawStyle": "line", "lineWidth": 2, "fillOpacity": 15, "showPoints": "never", "spanNulls": true, "thresholdsStyle": {"mode": "line"}}, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 60}, {"color": "red", "value": 80}]}, "unit": "percent", "displayName": "Nginx service", "min": 0, "max": 100}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "single"}},
      "targets": [{"refId": "A", "datasource": {"type": "cloudwatch", "uid": "cloudwatch"}, "queryMode": "Metrics", "metricQueryType": 0, "metricEditorMode": 0, "region": "default", "namespace": "AWS/ECS", "metricName": "CPUUtilization", "statistic": "Average", "dimensions": {"ClusterName": "${ecs_cluster_name}", "ServiceName": "${ecs_service_name}"}, "matchExact": true, "period": "60", "id": "", "expression": "", "label": ""}]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Healthy Web Servers (Nginx tasks)",
      "description": "Number of Nginx tasks that pass the load balancer health check. Should never drop below 2; goes up when Auto Scaling adds tasks.",
      "datasource": {"type": "cloudwatch", "uid": "cloudwatch"},
      "gridPos": {"x": 12, "y": 0, "w": 6, "h": 8},
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 2}]}, "mappings": [], "decimals": 0}, "overrides": []},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "colorMode": "value", "graphMode": "none", "justifyMode": "center", "textMode": "value", "orientation": "auto"},
      "targets": [{"refId": "A", "datasource": {"type": "cloudwatch", "uid": "cloudwatch"}, "queryMode": "Metrics", "metricQueryType": 0, "metricEditorMode": 0, "region": "default", "namespace": "AWS/ApplicationELB", "metricName": "HealthyHostCount", "statistic": "Maximum", "dimensions": {"LoadBalancer": "${alb_arn_suffix}", "TargetGroup": "${target_group_arn_suffix}"}, "matchExact": true, "period": "60", "id": "", "expression": "", "label": ""}]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Website Errors (5XX)",
      "description": "Number of 5XX errors from the load balancer in the selected time range. Same metric as the connectivity alarm.",
      "datasource": {"type": "cloudwatch", "uid": "cloudwatch"},
      "gridPos": {"x": 18, "y": 0, "w": 6, "h": 8},
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 1}]}, "mappings": [], "noValue": "0", "decimals": 0}, "overrides": []},
      "options": {"reduceOptions": {"calcs": ["sum"], "fields": "", "values": false}, "colorMode": "value", "graphMode": "none", "justifyMode": "center", "textMode": "value", "orientation": "auto"},
      "targets": [{"refId": "A", "datasource": {"type": "cloudwatch", "uid": "cloudwatch"}, "queryMode": "Metrics", "metricQueryType": 0, "metricEditorMode": 0, "region": "default", "namespace": "AWS/ApplicationELB", "metricName": "HTTPCode_ELB_5XX_Count", "statistic": "Sum", "dimensions": {"LoadBalancer": "${alb_arn_suffix}"}, "matchExact": true, "period": "60", "id": "", "expression": "", "label": ""}]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Website Requests (per minute)",
      "description": "Number of requests the load balancer sends to the website per minute. Explains why the CPU goes up during busy moments.",
      "datasource": {"type": "cloudwatch", "uid": "cloudwatch"},
      "gridPos": {"x": 0, "y": 8, "w": 12, "h": 8},
      "fieldConfig": {"defaults": {"color": {"mode": "palette-classic"}, "custom": {"drawStyle": "line", "lineWidth": 2, "fillOpacity": 15, "showPoints": "never", "spanNulls": true, "thresholdsStyle": {"mode": "off"}}, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}]}, "displayName": "Website", "decimals": 0, "min": 0}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "single"}},
      "targets": [{"refId": "A", "datasource": {"type": "cloudwatch", "uid": "cloudwatch"}, "queryMode": "Metrics", "metricQueryType": 0, "metricEditorMode": 0, "region": "default", "namespace": "AWS/ApplicationELB", "metricName": "RequestCount", "statistic": "Sum", "dimensions": {"LoadBalancer": "${alb_arn_suffix}", "TargetGroup": "${target_group_arn_suffix}"}, "matchExact": true, "period": "60", "id": "", "expression": "", "label": ""}]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Database Server Status",
      "description": "Is node_exporter on the database server reachable for Prometheus? DOWN means the server is down or unreachable.",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 12, "y": 8, "w": 6, "h": 8},
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}, "mappings": [{"type": "value", "options": {"0": {"text": "DOWN", "color": "red", "index": 0}, "1": {"text": "UP", "color": "green", "index": 1}}}]}, "overrides": []},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "colorMode": "value", "graphMode": "none", "justifyMode": "center", "textMode": "value", "orientation": "auto"},
      "targets": [{"refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "up{job=\"database\"}", "range": true, "instant": false, "legendFormat": "__auto"}]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Monitoring Status (Prometheus)",
      "description": "Is Prometheus itself running and able to collect metrics?",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 18, "y": 8, "w": 6, "h": 8},
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}, "mappings": [{"type": "value", "options": {"0": {"text": "DOWN", "color": "red", "index": 0}, "1": {"text": "UP", "color": "green", "index": 1}}}]}, "overrides": []},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "colorMode": "value", "graphMode": "none", "justifyMode": "center", "textMode": "value", "orientation": "auto"},
      "targets": [{"refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "up{job=\"prometheus\"}", "range": true, "instant": false, "legendFormat": "__auto"}]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Database CPU Usage (%)",
      "description": "CPU usage of the MariaDB EC2 instance (average over 5 minutes).",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 0, "y": 16, "w": 12, "h": 8},
      "fieldConfig": {"defaults": {"color": {"mode": "palette-classic"}, "custom": {"drawStyle": "line", "lineWidth": 2, "fillOpacity": 15, "showPoints": "never", "spanNulls": true, "thresholdsStyle": {"mode": "off"}}, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}]}, "unit": "percent", "displayName": "Database server", "min": 0}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "single"}},
      "targets": [{"refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "100 - (avg(rate(node_cpu_seconds_total{mode=\"idle\"}[5m])) * 100)", "range": true, "instant": false, "legendFormat": "__auto"}]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Database Memory Usage (%)",
      "description": "Memory usage of the MariaDB EC2 instance.",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 12, "y": 16, "w": 12, "h": 8},
      "fieldConfig": {"defaults": {"color": {"mode": "palette-classic"}, "custom": {"drawStyle": "line", "lineWidth": 2, "fillOpacity": 15, "showPoints": "never", "spanNulls": true, "thresholdsStyle": {"mode": "off"}}, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}]}, "unit": "percent", "displayName": "Database server", "min": 0, "max": 100}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "single"}},
      "targets": [{"refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "(1 - (node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)) * 100", "range": true, "instant": false, "legendFormat": "__auto"}]
    },
    {
      "id": 100,
      "type": "row",
      "title": "Hybrid network (CS2)",
      "collapsed": false,
      "gridPos": {"x": 0, "y": 24, "w": 24, "h": 1},
      "panels": []
    },
    {
      "id": 101,
      "type": "stat",
      "title": "VPN Tunnel 1 State",
      "description": "State of AWS VPN tunnel 1 to NetLab (fw01). This is the active tunnel.",
      "datasource": {"type": "cloudwatch", "uid": "cloudwatch"},
      "gridPos": {"x": 0, "y": 25, "w": 6, "h": 8},
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}, "mappings": [{"type": "value", "options": {"0": {"text": "DOWN", "color": "red", "index": 0}, "1": {"text": "UP", "color": "green", "index": 1}}}]}, "overrides": []},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "colorMode": "value", "graphMode": "none", "justifyMode": "center", "textMode": "value", "orientation": "auto"},
      "targets": [{"refId": "A", "datasource": {"type": "cloudwatch", "uid": "cloudwatch"}, "queryMode": "Metrics", "metricQueryType": 0, "metricEditorMode": 0, "region": "default", "namespace": "AWS/VPN", "metricName": "TunnelState", "statistic": "Maximum", "dimensions": {"VpnId": "${vpn_connection_id}", "TunnelIpAddress": "${vpn_tunnel1_address}"}, "matchExact": true, "period": "300", "id": "", "expression": "", "label": ""}]
    },
    {
      "id": 102,
      "type": "stat",
      "title": "VPN Tunnel 2 State (backup)",
      "description": "State of AWS VPN tunnel 2. It is configured on fw01 but disabled on purpose (manual backup), so STANDBY is normal.",
      "datasource": {"type": "cloudwatch", "uid": "cloudwatch"},
      "gridPos": {"x": 6, "y": 25, "w": 6, "h": 8},
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "blue", "value": null}, {"color": "green", "value": 1}]}, "mappings": [{"type": "value", "options": {"0": {"text": "STANDBY", "color": "blue", "index": 0}, "1": {"text": "UP", "color": "green", "index": 1}}}]}, "overrides": []},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "colorMode": "value", "graphMode": "none", "justifyMode": "center", "textMode": "value", "orientation": "auto"},
      "targets": [{"refId": "A", "datasource": {"type": "cloudwatch", "uid": "cloudwatch"}, "queryMode": "Metrics", "metricQueryType": 0, "metricEditorMode": 0, "region": "default", "namespace": "AWS/VPN", "metricName": "TunnelState", "statistic": "Maximum", "dimensions": {"VpnId": "${vpn_connection_id}", "TunnelIpAddress": "${vpn_tunnel2_address}"}, "matchExact": true, "period": "300", "id": "", "expression": "", "label": ""}]
    },
    {
      "id": 103,
      "type": "timeseries",
      "title": "VPN Traffic In / Out",
      "description": "Bytes through the VPN per 5 minutes (in = from NetLab to AWS, out = from AWS to NetLab).",
      "datasource": {"type": "cloudwatch", "uid": "cloudwatch"},
      "gridPos": {"x": 12, "y": 25, "w": 6, "h": 8},
      "fieldConfig": {"defaults": {"color": {"mode": "palette-classic"}, "custom": {"drawStyle": "line", "lineWidth": 2, "fillOpacity": 15, "showPoints": "never", "spanNulls": true, "thresholdsStyle": {"mode": "off"}}, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}]}, "decimals": 0, "min": 0, "unit": "decbytes"}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi"}},
      "targets": [{"refId": "A", "datasource": {"type": "cloudwatch", "uid": "cloudwatch"}, "queryMode": "Metrics", "metricQueryType": 0, "metricEditorMode": 0, "region": "default", "namespace": "AWS/VPN", "metricName": "TunnelDataIn", "statistic": "Sum", "dimensions": {"VpnId": "${vpn_connection_id}"}, "matchExact": true, "period": "300", "id": "", "expression": "", "label": "In"}, {"refId": "B", "datasource": {"type": "cloudwatch", "uid": "cloudwatch"}, "queryMode": "Metrics", "metricQueryType": 0, "metricEditorMode": 0, "region": "default", "namespace": "AWS/VPN", "metricName": "TunnelDataOut", "statistic": "Sum", "dimensions": {"VpnId": "${vpn_connection_id}"}, "matchExact": true, "period": "300", "id": "", "expression": "", "label": "Out"}]
    },
    {
      "id": 104,
      "type": "timeseries",
      "title": "Log Lines Received (per minute)",
      "description": "Log lines per minute that Loki receives from ws01 (auth log) and fw01 (firewall log). A line at 0 means a log source is silent (alert R5).",
      "datasource": {"type": "loki", "uid": "loki"},
      "gridPos": {"x": 18, "y": 25, "w": 6, "h": 8},
      "fieldConfig": {"defaults": {"color": {"mode": "palette-classic"}, "custom": {"drawStyle": "line", "lineWidth": 2, "fillOpacity": 15, "showPoints": "never", "spanNulls": false, "thresholdsStyle": {"mode": "off"}}, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}]}, "decimals": 0, "min": 0}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi"}},
      "targets": [{"refId": "A", "datasource": {"type": "loki", "uid": "loki"}, "editorMode": "code", "expr": "sum by (host) (count_over_time({host=~\"ws01|fw01\"}[1m]))", "queryType": "range", "legendFormat": "{{host}}"}]
    },
    {
      "id": 110,
      "type": "row",
      "title": "Security logs (CS2)",
      "collapsed": false,
      "gridPos": {"x": 0, "y": 33, "w": 24, "h": 1},
      "panels": []
    },
    {
      "id": 111,
      "type": "timeseries",
      "title": "Failed SSH Logins (per 5 min, ws01)",
      "description": "Failed SSH logins on ws01 in the last 5 minutes. 1 or more fires alert R1, 5 or more from one IP fires alert R2.",
      "datasource": {"type": "loki", "uid": "loki"},
      "gridPos": {"x": 0, "y": 34, "w": 8, "h": 8},
      "fieldConfig": {"defaults": {"color": {"mode": "palette-classic"}, "custom": {"drawStyle": "line", "lineWidth": 2, "fillOpacity": 15, "showPoints": "never", "spanNulls": false, "thresholdsStyle": {"mode": "off"}}, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}]}, "decimals": 0, "min": 0, "noValue": "0"}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi"}},
      "targets": [{"refId": "A", "datasource": {"type": "loki", "uid": "loki"}, "editorMode": "code", "expr": "sum by (host) (count_over_time({job=\"auth\"} |= \"Failed password\" [5m]))", "queryType": "range", "legendFormat": "{{host}}"}]
    },
    {
      "id": 112,
      "type": "timeseries",
      "title": "Firewall Blocks (per minute, fw01)",
      "description": "Connections blocked by fw01 per minute. A sudden peak from one source can be a port scan (alert R3).",
      "datasource": {"type": "loki", "uid": "loki"},
      "gridPos": {"x": 8, "y": 34, "w": 8, "h": 8},
      "fieldConfig": {"defaults": {"color": {"mode": "palette-classic"}, "custom": {"drawStyle": "bars", "lineWidth": 2, "fillOpacity": 40, "showPoints": "never", "spanNulls": true, "thresholdsStyle": {"mode": "off"}}, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}]}, "decimals": 0, "min": 0}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi"}},
      "targets": [{"refId": "A", "datasource": {"type": "loki", "uid": "loki"}, "editorMode": "code", "expr": "sum by (host) (count_over_time({job=\"firewall\"} |= \",block,\" [1m]))", "queryType": "range", "legendFormat": "{{host}}"}]
    },
    {
      "id": 113,
      "type": "bargauge",
      "title": "Top Blocked Source IPs (last hour)",
      "description": "The 5 IPv4 addresses with the most blocked connections on fw01 in the last hour.",
      "datasource": {"type": "loki", "uid": "loki"},
      "gridPos": {"x": 16, "y": 34, "w": 8, "h": 8},
      "fieldConfig": {"defaults": {"color": {"mode": "continuous-YlRd"}, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}]}, "decimals": 0, "min": 0}, "overrides": []},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": true}, "orientation": "horizontal", "displayMode": "gradient", "showUnfilled": true, "valueMode": "color", "namePlacement": "auto"},
      "targets": [{"refId": "A", "datasource": {"type": "loki", "uid": "loki"}, "editorMode": "code", "expr": "topk(5, sum by (src_ip) (count_over_time({job=\"firewall\"} |= \",block,in,4,\" | regexp `,block,in,4,(?:[^,]*,){9}(?P<src_ip>[0-9.]+),` [1h])))", "queryType": "instant", "legendFormat": "{{src_ip}}"}],
      "transformations": [{"id": "sortBy", "options": {"fields": {}, "sort": [{"field": "Value #A", "desc": true}]}}]
    },
    {
      "id": 114,
      "type": "logs",
      "title": "Latest Log Lines (ws01 + fw01)",
      "description": "The newest log lines from the auth log of ws01 and the firewall log of fw01, live from Loki.",
      "datasource": {"type": "loki", "uid": "loki"},
      "gridPos": {"x": 0, "y": 42, "w": 24, "h": 10},
      "options": {"showTime": true, "showLabels": false, "showCommonLabels": false, "wrapLogMessage": true, "prettifyLogMessage": false, "enableLogDetails": true, "dedupStrategy": "none", "sortOrder": "Descending"},
      "targets": [{"refId": "A", "datasource": {"type": "loki", "uid": "loki"}, "editorMode": "code", "expr": "{host=~\"ws01|fw01\"}", "queryType": "range"}]
    },
    {
      "id": 120,
      "type": "row",
      "title": "SOAR (CS2)",
      "collapsed": false,
      "gridPos": {"x": 0, "y": 52, "w": 24, "h": 1},
      "panels": []
    },
    {
      "id": 121,
      "type": "stat",
      "title": "SOAR Tasks Up",
      "description": "Number of SOAR tasks that Prometheus can reach. The design runs 2 tasks in 2 AZs.",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 0, "y": 53, "w": 4, "h": 8},
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "orange", "value": 1}, {"color": "green", "value": 2}]}, "mappings": [], "decimals": 0, "noValue": "0"}, "overrides": []},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "colorMode": "value", "graphMode": "none", "justifyMode": "center", "textMode": "value", "orientation": "auto"},
      "targets": [{"refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "count(up{job=\"soar\"} == 1)", "range": false, "instant": true, "legendFormat": "__auto"}]
    },
    {
      "id": 122,
      "type": "stat",
      "title": "Failed Actions (24h)",
      "description": "Response actions (S3 incident or e-mail) that failed in the last 24 hours. Should be 0.",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 4, "y": 53, "w": 4, "h": 8},
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 1}]}, "mappings": [], "decimals": 0, "noValue": "0"}, "overrides": []},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "colorMode": "value", "graphMode": "none", "justifyMode": "center", "textMode": "value", "orientation": "auto"},
      "targets": [{"refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "sum(increase(soar_actions_total{result=\"failed\"}[24h])) or vector(0)", "range": false, "instant": true, "legendFormat": "__auto"}]
    },
    {
      "id": 123,
      "type": "timeseries",
      "title": "Events Received (per type)",
      "description": "Alerts from Grafana that the SOAR processed, per alert type (per 5 minutes).",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 8, "y": 53, "w": 8, "h": 8},
      "fieldConfig": {"defaults": {"color": {"mode": "palette-classic"}, "custom": {"drawStyle": "bars", "lineWidth": 2, "fillOpacity": 40, "showPoints": "never", "spanNulls": false, "thresholdsStyle": {"mode": "off"}}, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}]}, "min": 0, "noValue": "0", "decimals": 0}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi"}},
      "targets": [{"refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "sum by (type) (increase(soar_events_received_total[5m]))", "range": true, "instant": false, "legendFormat": "{{type}}"}]
    },
    {
      "id": 124,
      "type": "timeseries",
      "title": "Actions: Success vs Failed",
      "description": "Response actions per 5 minutes: log_incident (S3) and notify (e-mail), split by result.",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 16, "y": 53, "w": 8, "h": 8},
      "fieldConfig": {"defaults": {"color": {"mode": "palette-classic"}, "custom": {"drawStyle": "bars", "lineWidth": 2, "fillOpacity": 40, "showPoints": "never", "spanNulls": false, "thresholdsStyle": {"mode": "off"}}, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}]}, "min": 0, "noValue": "0", "decimals": 0}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi"}},
      "targets": [{"refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "sum by (action, result) (increase(soar_actions_total[5m]))", "range": true, "instant": false, "legendFormat": "{{action}} {{result}}"}]
    },
    {
      "id": 125,
      "type": "timeseries",
      "title": "Processing Time (avg)",
      "description": "Average time the SOAR needs to process one alert, including the S3 and SNS calls.",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 0, "y": 61, "w": 12, "h": 8},
      "fieldConfig": {"defaults": {"color": {"mode": "palette-classic"}, "custom": {"drawStyle": "line", "lineWidth": 2, "fillOpacity": 15, "showPoints": "never", "spanNulls": false, "thresholdsStyle": {"mode": "off"}}, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}]}, "min": 0, "noValue": "0", "decimals": 3, "unit": "s"}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi"}},
      "targets": [{"refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "sum(rate(soar_processing_seconds_sum[5m])) / sum(rate(soar_processing_seconds_count[5m]))", "range": true, "instant": false, "legendFormat": "avg processing time"}]
    },
    {
      "id": 126,
