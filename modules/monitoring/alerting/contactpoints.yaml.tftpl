# Grafana contact point and notification policy (CS2 block 6).
# Every alert (R1-R5) is sent as JSON to the SOAR webhook.
apiVersion: 1
contactPoints:
  - orgId: 1
    name: soar-webhook
    receivers:
      - uid: soar-webhook
        type: webhook
        disableResolveMessage: false
        settings:
          url: ${soar_webhook_url}
          httpMethod: POST

policies:
  - orgId: 1
    receiver: soar-webhook
    group_by: ["alertname", "host"]
    group_wait: 10s
    group_interval: 1m
    repeat_interval: 4h