// Alloy on {{ inventory_hostname }} - reads the auth log and sends it to Loki on mgmt01
// (template: the same file for every workstation in the inventory)

local.file_match "auth" {
  path_targets = [{
    "__path__" = "/var/log/auth.log",
    "job"      = "auth",
    "host"     = "{{ inventory_hostname }}",
  }]
}

loki.source.file "auth" {
  targets    = local.file_match.auth.targets
  forward_to = [loki.write.mgmt01.receiver]
}

loki.write "mgmt01" {
  endpoint {
    url = "http://192.168.20.10:3100/loki/api/v1/push"
  }
}